rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // SOS data model: ownerId, status (active|resolved), latitude/longitude,
    // address, isSilent, createdAt, updatedAt, and resolvedAt. This collection
    // intentionally excludes medical profiles and emergency contact numbers.
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Qurbani plans are private household records. The plan owner controls
    // membership; a member may work only inside a plan that already includes
    // their UID.
    function isPlanMember(ownerUid, planId) {
      return signedIn()
        && (request.auth.uid == ownerUid
          || request.auth.uid in get(/databases/$(database)/documents/users/$(ownerUid)/qurbaniPlans/$(planId)).data.memberIds
          || exists(/databases/$(database)/documents/users/$(ownerUid)/qurbaniPlans/$(planId)/members/$(request.auth.uid)));
    }

    function validShortText(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    function validQurbaniPlan(data, ownerUid) {
      return data.keys().hasOnly([
          'year', 'status', 'animalType', 'totalShares', 'myShares',
          'estimatedCost', 'paidAmount', 'vendorName', 'vendorPhone',
          'slaughterDate', 'notes', 'ownerId', 'ownerName', 'memberIds',
          'inviteCode', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'year', 'status', 'animalType', 'totalShares', 'myShares',
          'estimatedCost', 'paidAmount', 'ownerId', 'ownerName', 'memberIds',
          'createdAt', 'updatedAt'
        ])
        && data.year is int && data.year >= 2020 && data.year <= 2100
        && data.status in ['planned', 'confirmed', 'completed', 'cancelled']
        && data.animalType in ['cow', 'goat', 'sheep', 'camel']
        && data.totalShares is int && data.totalShares >= 1 && data.totalShares <= 7
        && data.myShares is int && data.myShares >= 1 && data.myShares <= data.totalShares
        && data.estimatedCost is number && data.estimatedCost >= 0 && data.estimatedCost <= 10000000
        && data.paidAmount is number && data.paidAmount >= 0 && data.paidAmount <= 10000000
        && (data.vendorName == null || validShortText(data.vendorName, 120))
        && (data.vendorPhone == null || validShortText(data.vendorPhone, 30))
        && (data.slaughterDate == null || data.slaughterDate is timestamp)
        && (data.notes == null || validShortText(data.notes, 2000))
        && data.ownerId == ownerUid
        && validShortText(data.ownerName, 80)
        && data.memberIds is list && data.memberIds.size() >= 1 && data.memberIds.size() <= 20
        && (!data.keys().hasAll(['inviteCode']) || validShortText(data.inviteCode, 20))
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function validParticipant(data) {
      return data.keys().hasOnly(['name', 'phone', 'shares', 'amountDue', 'amountPaid', 'paymentStatus', 'ownerId', 'ownerName'])
        && data.keys().hasAll(['name', 'shares', 'amountDue', 'amountPaid', 'paymentStatus', 'ownerId', 'ownerName'])
        && validShortText(data.name, 100)
        && (data.phone == null || validShortText(data.phone, 30))
        && data.shares is int && data.shares >= 1 && data.shares <= 7
        && data.amountDue is number && data.amountDue >= 0 && data.amountDue <= 10000000
        && data.amountPaid is number && data.amountPaid >= 0 && data.amountPaid <= 10000000
        && data.paymentStatus in ['unpaid', 'partial', 'paid']
        && validShortText(data.ownerId, 128) && validShortText(data.ownerName, 80);
    }

    function validExpense(data) {
      return data.keys().hasOnly(['category', 'amount', 'notes', 'payers', 'ownerId', 'ownerName', 'createdAt'])
        && data.keys().hasAll(['category', 'amount', 'notes', 'payers', 'ownerId', 'ownerName', 'createdAt'])
        && validShortText(data.category, 80)
        && data.amount is number && data.amount > 0 && data.amount <= 10000000
        && validShortText(data.notes, 1000)
        && data.payers is list && data.payers.size() <= 20
        && validShortText(data.ownerId, 128) && validShortText(data.ownerName, 80)
        && data.createdAt is timestamp;
    }

    function validSettlement(data) {
      return data.keys().hasOnly(['fromId', 'fromName', 'toId', 'toName', 'amount', 'confirmed', 'date'])
        && data.keys().hasAll(['fromId', 'fromName', 'toId', 'toName', 'amount', 'confirmed', 'date'])
        && validShortText(data.fromId, 128) && validShortText(data.fromName, 100)
        && validShortText(data.toId, 128) && validShortText(data.toName, 100)
        && data.amount is number && data.amount > 0 && data.amount <= 10000000
        && data.confirmed is bool && data.date is timestamp;
    }

    function validEditRequest(data) {
      return data.keys().hasOnly(['targetType', 'targetId', 'targetLabel', 'requestedById', 'requestedByName', 'reason', 'proposedChanges', 'status', 'createdAt'])
        && data.keys().hasAll(['targetType', 'targetId', 'targetLabel', 'requestedById', 'requestedByName', 'reason', 'proposedChanges', 'status', 'createdAt'])
        && data.targetType in ['participant', 'expense']
        && validShortText(data.targetId, 128) && validShortText(data.targetLabel, 160)
        && validShortText(data.requestedById, 128) && validShortText(data.requestedByName, 80)
        && validShortText(data.reason, 500) && data.proposedChanges is map && data.proposedChanges.size() <= 5
        && data.status in ['pending', 'approved', 'rejected'] && data.createdAt is timestamp;
    }

    function validLocation(latitude, longitude) {
      return latitude is number && longitude is number
        && latitude >= -90 && latitude <= 90
        && longitude >= -180 && longitude <= 180;
    }

    function validEmergencyGroup(data, groupCode) {
      return data.keys().hasOnly([
          'code', 'name', 'leaderId', 'leaderName', 'rangeMeters',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'code', 'name', 'leaderId', 'leaderName', 'rangeMeters',
          'createdAt'
        ])
        && data.code == groupCode
        && validShortText(data.code, 20)
        && validShortText(data.name, 120)
        && data.leaderId is string && data.leaderId == request.auth.uid
        && validShortText(data.leaderName, 80)
        && data.rangeMeters is number
        && data.rangeMeters >= 100 && data.rangeMeters <= 10000
        && data.createdAt is timestamp
        && (!data.keys().hasAll(['updatedAt']) || data.updatedAt is timestamp);
    }

    function validEmergencyMember(data) {
      return data.keys().hasOnly([
          'name', 'photoUrl', 'photoBase64', 'isLeader', 'joinedAt',
          'updatedAt', 'latitude', 'longitude'
        ])
        && data.keys().hasAll(['name', 'photoUrl', 'isLeader', 'joinedAt', 'updatedAt'])
        && validShortText(data.name, 80)
        && validShortText(data.photoUrl, 2048)
        && (!data.keys().hasAll(['photoBase64'])
          || validShortText(data.photoBase64, 200000))
        && data.isLeader is bool
        && data.joinedAt is timestamp
        && data.updatedAt is timestamp
        && ((data.keys().hasAll(['latitude', 'longitude'])
          && validLocation(data.latitude, data.longitude))
          || (!data.keys().hasAll(['latitude'])
            && !data.keys().hasAll(['longitude'])));
    }

    function validSosIncident() {
      return request.resource.data.keys().hasOnly([
          'ownerId', 'status', 'latitude', 'longitude', 'address', 'isSilent',
          'createdAt', 'updatedAt', 'resolvedAt'
        ])
        && request.resource.data.keys().hasAll([
          'ownerId', 'status', 'latitude', 'longitude', 'address', 'isSilent',
          'createdAt', 'updatedAt', 'resolvedAt'
        ])
        && request.resource.data.ownerId is string
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status in ['active', 'resolved']
        && validLocation(request.resource.data.latitude, request.resource.data.longitude)
        && request.resource.data.address is string
        && request.resource.data.address.size() <= 240
        && request.resource.data.isSilent is bool
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && (request.resource.data.resolvedAt == null || request.resource.data.resolvedAt is timestamp);
    }

    match /sosIncidents/{incidentId} {
      allow read: if isOwner(resource.data.ownerId);
      allow create: if signedIn() && validSosIncident()
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.resolvedAt == null;
      allow update: if isOwner(resource.data.ownerId)
        && validSosIncident()
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && ((resource.data.status == 'active' && request.resource.data.status in ['active', 'resolved'])
          || (resource.data.status == 'resolved' && request.resource.data.status == 'resolved'))
        && ((request.resource.data.status == 'active' && request.resource.data.resolvedAt == null)
          || (request.resource.data.status == 'resolved' && request.resource.data.resolvedAt is timestamp));
      allow delete: if false;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Assumed model: a private Qurbani plan is stored below its owner's
      // user document. memberIds is the access-control list and may be
      // changed only by that owner.
      match /qurbaniPlans/{planId} {
        allow create: if isOwner(userId)
          && validQurbaniPlan(request.resource.data, userId)
          && request.resource.data.memberIds.hasOnly([request.auth.uid]);
        allow read: if isPlanMember(userId, planId);
        allow update: if isOwner(userId)
          && validQurbaniPlan(request.resource.data, userId)
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isOwner(userId);

        // Mirrors emergencyGroups/members: knowing a valid share code lets a
        // signed-in person create only their own membership record.
        match /members/{memberId} {
          allow read: if isPlanMember(userId, planId);
          allow create: if signedIn()
            && request.auth.uid == memberId
            && request.resource.data.keys().hasOnly(['name', 'shares', 'joinedAt', 'updatedAt'])
            && request.resource.data.keys().hasAll(['name', 'shares', 'joinedAt', 'updatedAt'])
            && validShortText(request.resource.data.name, 80)
            && request.resource.data.shares is int && request.resource.data.shares >= 1 && request.resource.data.shares <= 7
            && request.resource.data.joinedAt is timestamp
            && request.resource.data.updatedAt is timestamp;
          allow update: if signedIn()
            && request.auth.uid == memberId
            && request.resource.data.keys().hasOnly(['name', 'shares', 'joinedAt', 'updatedAt'])
            && request.resource.data.keys().hasAll(['name', 'shares', 'joinedAt', 'updatedAt'])
            && validShortText(request.resource.data.name, 80)
            && request.resource.data.shares is int && request.resource.data.shares >= 1 && request.resource.data.shares <= 7
            && request.resource.data.joinedAt == resource.data.joinedAt
            && request.resource.data.updatedAt is timestamp;
          allow delete: if signedIn()
            && (request.auth.uid == memberId || request.auth.uid == userId);
        }

        match /participants/{participantId} {
          allow read: if isPlanMember(userId, planId);
          allow create: if isPlanMember(userId, planId)
            && validParticipant(request.resource.data)
            && request.resource.data.ownerId == request.auth.uid;
          allow update: if isPlanMember(userId, planId)
            && validParticipant(request.resource.data)
            && request.resource.data.ownerId == resource.data.ownerId
            && (request.auth.uid == userId
              || request.auth.uid == resource.data.ownerId
              || request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['amountDue', 'amountPaid', 'paymentStatus']));
          allow delete: if isPlanMember(userId, planId)
            && (request.auth.uid == userId || request.auth.uid == resource.data.ownerId);
        }

        match /expenses/{expenseId} {
          allow read: if isPlanMember(userId, planId);
          allow create: if isPlanMember(userId, planId)
            && validExpense(request.resource.data)
            && request.resource.data.ownerId == request.auth.uid;
          allow update: if isPlanMember(userId, planId)
            && validExpense(request.resource.data)
            && request.resource.data.ownerId == resource.data.ownerId
            && request.resource.data.createdAt == resource.data.createdAt
            && (request.auth.uid == userId || request.auth.uid == resource.data.ownerId);
          allow delete: if isPlanMember(userId, planId)
            && (request.auth.uid == userId || request.auth.uid == resource.data.ownerId);
        }

        match /settlements/{settlementId} {
          allow read: if isPlanMember(userId, planId);
          allow create: if isPlanMember(userId, planId)
            && validSettlement(request.resource.data);
          allow update, delete: if false;
        }

        match /editRequests/{requestId} {
          allow read: if isPlanMember(userId, planId);
          allow create: if isPlanMember(userId, planId)
            && validEditRequest(request.resource.data)
            && request.resource.data.requestedById == request.auth.uid
            && request.resource.data.status == 'pending';
          allow update: if isOwner(userId)
            && validEditRequest(request.resource.data)
            && request.resource.data.requestedById == resource.data.requestedById
            && request.resource.data.createdAt == resource.data.createdAt;
          allow delete: if false;
        }

        match /checklist/{itemId} {
          allow read: if isPlanMember(userId, planId);
          allow create, update: if isPlanMember(userId, planId)
            && request.resource.data.keys().hasOnly(['done'])
            && request.resource.data.done is bool;
          allow delete: if isPlanMember(userId, planId);
        }
      }
    }

    // SOS-style share-code lookup. Codes cannot be listed, and only a plan
    // owner may create a code that points to their own plan.
    match /qurbaniPlanInvites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['ownerUid', 'planId', 'createdAt'])
        && request.resource.data.keys().hasAll(['ownerUid', 'planId', 'createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && validShortText(request.resource.data.planId, 128)
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/qurbaniPlans/$(request.resource.data.planId))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)/qurbaniPlans/$(request.resource.data.planId)).data.ownerId == request.auth.uid
        && request.resource.data.createdAt is timestamp;
      allow update: if false;
      allow delete: if signedIn()
        && resource.data.ownerUid == request.auth.uid;
    }

    match /support_messages/{messageId} {
      allow create: if request.auth != null;
    }

    match /emergencyGroups/{groupCode} {
      // A signed-in user needs get access to validate a shared code. Listing
      // groups is deliberately forbidden, so codes cannot be enumerated.
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if signedIn()
        && validEmergencyGroup(request.resource.data, groupCode)
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn()
        && resource.data.leaderId == request.auth.uid
        && validEmergencyGroup(request.resource.data, groupCode)
        && request.resource.data.leaderId == resource.data.leaderId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['rangeMeters', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;
      allow delete: if signedIn()
        && resource.data.leaderId == request.auth.uid;

      match /members/{memberId} {
        // A user may check only their own membership before joining. Listing
        // the roster remains restricted to established group members.
        allow get: if signedIn()
          && (request.auth.uid == memberId
            || exists(/databases/$(database)/documents/emergencyGroups/$(groupCode)/members/$(request.auth.uid)));
        allow list: if signedIn()
          && exists(/databases/$(database)/documents/emergencyGroups/$(groupCode)/members/$(request.auth.uid));
        allow create: if signedIn()
          && request.auth.uid == memberId
          && validEmergencyMember(request.resource.data)
          && request.resource.data.joinedAt == request.time
          && request.resource.data.updatedAt == request.time
          // A joining user cannot grant themselves leadership. The creator's
          // leader membership is permitted only in the same atomic batch.
          && (request.resource.data.isLeader == false
            || getAfter(/databases/$(database)/documents/emergencyGroups/$(groupCode)).data.leaderId == request.auth.uid);
        // A member can update only their own presence fields. The owner can
        // remove a member but cannot impersonate or edit them.
        allow update: if signedIn()
          && request.auth.uid == memberId
          && validEmergencyMember(request.resource.data)
          && request.resource.data.isLeader == resource.data.isLeader
          && request.resource.data.joinedAt == resource.data.joinedAt
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'photoUrl', 'photoBase64', 'latitude', 'longitude', 'updatedAt']);
        allow delete: if signedIn()
          && (request.auth.uid == memberId
            || get(/databases/$(database)/documents/emergencyGroups/$(groupCode)).data.leaderId == request.auth.uid);
      }

      // Group chat is visible only to current group members.
      match /messages/{messageId} {
        allow read: if request.auth != null
          && exists(/databases/$(database)/documents/emergencyGroups/$(groupCode)/members/$(request.auth.uid));
        allow create: if request.auth != null
          && exists(/databases/$(database)/documents/emergencyGroups/$(groupCode)/members/$(request.auth.uid))
          && request.resource.data.keys().hasOnly(['senderId', 'senderName', 'text', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() <= 80
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      match /incidents/{incidentId} {
        allow read: if request.auth != null
          && exists(/databases/$(database)/documents/emergencyGroups/$(groupCode)/members/$(request.auth.uid));
        allow create: if request.auth != null
          && exists(/databases/$(database)/documents/emergencyGroups/$(groupCode)/members/$(request.auth.uid))
          && request.resource.data.keys().hasOnly(['senderId', 'senderName', 'latitude', 'longitude', 'address', 'status', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string && request.resource.data.senderName.size() <= 80
          && validLocation(request.resource.data.latitude, request.resource.data.longitude)
          && request.resource.data.address is string && request.resource.data.address.size() <= 240
          && request.resource.data.status == 'active'
          && request.resource.data.createdAt == request.time;
        // Only the person who raised the alert may mark it resolved. This
        // prevents a leader or another member from hiding someone else's SOS.
        allow update: if signedIn()
          && exists(/databases/$(database)/documents/emergencyGroups/$(groupCode)/members/$(request.auth.uid))
          && resource.data.senderId == request.auth.uid
          && resource.data.status == 'active'
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.senderName == resource.data.senderName
          && request.resource.data.latitude == resource.data.latitude
          && request.resource.data.longitude == resource.data.longitude
          && request.resource.data.address == resource.data.address
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.status == 'resolved'
          && request.resource.data.updatedAt == request.time
          && request.resource.data.resolvedAt == request.time
          && request.resource.data.keys().hasOnly([
            'senderId', 'senderName', 'latitude', 'longitude', 'address',
            'status', 'createdAt', 'updatedAt', 'resolvedAt'
          ]);
        allow delete: if false;
      }
    }
  }
}
